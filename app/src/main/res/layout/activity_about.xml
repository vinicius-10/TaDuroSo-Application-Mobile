<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".About">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ab_cl_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/ab_vertical_gap"
            android:onClick="openSite"
            android:orientation="vertical"
            android:showDividers="middle">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="logo da utfpr"
                android:scaleType="fitXY"
                android:src="@drawable/utfpr___id_visual_horizontal_colorida" />

            <TextView
                android:id="@+id/ab_tv_student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ab_tv_student" />

            <TextView
                android:id="@+id/ab_tv_course"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ab_tv_course" />

            <TextView
                android:id="@+id/ab_tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoLink="email"
                android:text="@string/ab_tv_email" />

            <TextView
                android:id="@+id/ab_tv_descripition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ab_tv_descripition" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>