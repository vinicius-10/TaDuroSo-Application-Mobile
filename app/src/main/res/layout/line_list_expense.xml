<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/lle_tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/mer_tv_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lle_tv_field_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/lle_tv_field_essential"
        app:layout_constraintStart_toEndOf="@+id/lle_tv_name"
        app:layout_constraintTop_toTopOf="@+id/lle_tv_name" />

    <TextView
        android:id="@+id/lle_tv_field_essential"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lle_tv_field_name"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lle_tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/mer_tv_date"
        app:layout_constraintEnd_toStartOf="@+id/lle_tv_field_date"
        app:layout_constraintTop_toBottomOf="@+id/lle_tv_name" />

    <TextView
        android:id="@+id/lle_tv_field_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="DD/MM/AAAA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lle_tv_date" />

    <TextView
        android:id="@+id/lle_tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/mer_tv_value"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lle_tv_name" />

    <TextView
        android:id="@+id/lle_tv_field_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/lle_tv_value"
        app:layout_constraintTop_toTopOf="@+id/lle_tv_value" />
</androidx.constraintlayout.widget.ConstraintLayout>